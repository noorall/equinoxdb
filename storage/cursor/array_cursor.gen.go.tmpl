package cursor

import (
	"equinox/storage/config"
	"equinox/storage/store"
	"equinox/storage/types"
	"sort"
)

// Array Cursors

{{range .}}
{{$arrayType := print "*types." .Name "Array"}}
{{$type := print .Name "ArrayAscendingCursor"}}
{{$Type := print .Name "ArrayAscendingCursor"}}

type {{$type}} struct {
	cache struct {
		values types.Values
		pos    int
	}

	sst struct {
		buf       {{$arrayType}}
		values    {{$arrayType}}
		pos       int
		keyCursor *store.KeyCursor
	}

	end int64
	res {{$arrayType}}
}

func New{{$Type}}() *{{$type}} {
	c := &{{$type}}{
		res: types.New{{.Name}}ArrayLen(config.DefaultMaxPointsPerBlock),
	}
	c.sst.buf = types.New{{.Name}}ArrayLen(config.DefaultMaxPointsPerBlock)
	return c
}

func (c *{{$type}}) Reset(seek, end int64, cacheValues types.Values, sstKeyCursor *store.KeyCursor) {
c.end = end
	c.cache.values = cacheValues
	c.cache.pos = sort.Search(len(c.cache.values), func(i int) bool {
		return c.cache.values[i].UnixNano() >= seek
	})

	c.sst.keyCursor = sstKeyCursor
	c.sst.values, _ = c.sst.keyCursor.Read{{.Name}}ArrayBlock(c.sst.buf)
	c.sst.pos = sort.Search(c.sst.values.Len(), func(i int) bool {
		return c.sst.values.Timestamps[i] >= seek
	})
}

func (c *{{$type}}) Err() error        { return nil }

// close closes the cursor and any dependent cursors.
func (c *{{$type}}) Close() {
	if c.sst.keyCursor != nil {
		c.sst.keyCursor.Close()
		c.sst.keyCursor = nil
	}
	c.cache.values = nil
	c.sst.values = nil
}

// Next returns the next key/value for the cursor.
func (c *{{$type}}) Next() {{$arrayType}} {
	pos := 0
	cvals := c.cache.values
	tvals := c.sst.values

	c.res.Timestamps = c.res.Timestamps[:cap(c.res.Timestamps)]
	c.res.Values = c.res.Values[:cap(c.res.Values)]

	for pos < len(c.res.Timestamps) && c.sst.pos < len(tvals.Timestamps) && c.cache.pos < len(cvals) {
		ckey := cvals[c.cache.pos].UnixNano()
		tkey := tvals.Timestamps[c.sst.pos]
		if ckey == tkey {
			c.res.Timestamps[pos] = ckey
			c.res.Values[pos] = cvals[c.cache.pos].(types.{{.Name}}Value).RawValue()
			c.cache.pos++
			c.sst.pos++
		} else if ckey < tkey {
			c.res.Timestamps[pos] = ckey
			c.res.Values[pos] = cvals[c.cache.pos].(types.{{.Name}}Value).RawValue()
			c.cache.pos++
		} else {
			c.res.Timestamps[pos] = tkey
			c.res.Values[pos] = tvals.Values[c.sst.pos]
			c.sst.pos++
		}

		pos++

		if c.sst.pos >= len(tvals.Timestamps) {
			tvals = c.nextSST()
		}
	}

	if pos < len(c.res.Timestamps) {
		if c.sst.pos < len(tvals.Timestamps) {
			if pos == 0 && len(c.res.Timestamps) >= len(tvals.Timestamps){
				// optimization: all points can be served from SST data because
				// we need the entire block and the block completely fits within
				// the buffer.
				copy(c.res.Timestamps, tvals.Timestamps)
				pos += copy(c.res.Values, tvals.Values)
				c.nextSST()
			} else {
				// copy as much as we can
				n := copy(c.res.Timestamps[pos:], tvals.Timestamps[c.sst.pos:])
				copy(c.res.Values[pos:], tvals.Values[c.sst.pos:])
				pos += n
				c.sst.pos += n
				if c.sst.pos >= len(tvals.Timestamps) {
					c.nextSST()
				}
			}
		}

		if c.cache.pos < len(cvals) {
			// SST was exhausted
			for pos < len(c.res.Timestamps) && c.cache.pos < len(cvals) {
				c.res.Timestamps[pos] = cvals[c.cache.pos].UnixNano()
				c.res.Values[pos] = cvals[c.cache.pos].(types.{{.Name}}Value).RawValue()
				pos++
				c.cache.pos++
			}
		}
	}

	// Strip timestamps from after the end time.
	if pos > 0 && c.res.Timestamps[pos-1] > c.end {
		pos -= 2
		for pos >= 0 && c.res.Timestamps[pos] > c.end {
			pos--
		}
		pos++
	}

	c.res.Timestamps = c.res.Timestamps[:pos]
	c.res.Values = c.res.Values[:pos]

	return c.res
}

func (c *{{$type}}) nextSST() {{$arrayType}} {
	c.sst.keyCursor.Next()
	c.sst.values, _ = c.sst.keyCursor.Read{{.Name}}ArrayBlock(c.sst.buf)
	c.sst.pos = 0
	return c.sst.values
}

